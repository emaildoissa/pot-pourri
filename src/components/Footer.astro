---
import { homeContent } from "../config/home";
import { siteConfig } from "../config/site";

const year = new Date().getFullYear();
---

<footer id="contato" class="site-footer">
  <div class="container section-grid" style="margin-bottom: 3.5rem;">
    <div class="section-kicker">
      <p class="label-eyebrow reveal" style="color: var(--gold);">{homeContent.footer.eyebrow}</p>
    </div>

    <div style="grid-column: 4 / span 9;">
      <div
        class="reveal"
        style="border: 1px solid var(--gold); background: linear-gradient(135deg, rgb(24 19 15 / 0.95), rgb(36 28 22 / 0.8)); padding: clamp(2rem, 5vw, 3.5rem); border-radius: 2px; box-shadow: 0 10px 40px rgb(0 0 0 / 0.5);"
      >
        <h2
          class="display"
          style="font-size: clamp(2rem, 4vw, 3.2rem); color: var(--cream); margin: 0 0 1rem;"
        >
          {homeContent.footer.heading}
        </h2>
        <p
          style="font-size: 1.1rem; color: var(--muted-foreground); line-height: 1.7; margin-bottom: 2rem; max-width: 42rem;"
        >
          {homeContent.footer.subheading}
        </p>

        <div style="display: flex; gap: 1.5rem; flex-wrap: wrap; align-items: center;">
          <a
            class="button-gold"
            href={siteConfig.whatsappUrl}
            target="_blank"
            rel="noreferrer"
            style="font-size: 0.85rem; padding: 1.1rem 1.8rem;"
          >
            <svg style="width: 1.2rem; height: 1.2rem; fill: currentColor;" viewBox="0 0 24 24">
              <path
                d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"
              ></path>
            </svg>
            {homeContent.footer.whatsappButton}
          </a>
        </div>
      </div>
    </div>
  </div>

  <div class="container footer-grid">
    <div class="footer-brand">
      <div style="display: flex; align-items: center; gap: 1.25rem; margin-bottom: 1.25rem;">
        <img
          src="/logo.png"
          alt="Logo Pot. Pourri"
          width="130"
          height="130"
          style="height: clamp(90px, 12vw, 130px); width: auto; object-fit: contain; border-radius: 6px; filter: drop-shadow(0 4px 16px rgba(0,0,0,0.6));"
        />
        <strong style="color: var(--cream); font-size: 1.75rem; letter-spacing: 0.14em;"
          >{siteConfig.name.toUpperCase()}</strong
        >
      </div>
      <p style="color: var(--muted-foreground); font-size: 0.95rem; margin-top: 1rem;">
        {homeContent.footer.tagline}
      </p>
    </div>

    <div class="footer-col">
      <p class="label-eyebrow" style="color: var(--gold);">{homeContent.footer.addressTitle}</p>
      <p style="color: var(--cream); font-size: 0.95rem;">
        <svg
          style="width: 1.1rem; height: 1.1rem; fill: var(--gold); display: inline-block; vertical-align: sub; margin-right: 0.35rem;"
          viewBox="0 0 24 24"
        >
          <path
            d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"
          ></path>
        </svg>
        {siteConfig.address.street}
      </p>
      <p style="color: var(--muted-foreground); font-size: 0.9rem;">
        {siteConfig.address.neighborhood}
      </p>
      <p style="color: var(--muted-foreground); font-size: 0.9rem;">
        {siteConfig.address.postalCode}
      </p>
    </div>

    <div class="footer-col">
      <p class="label-eyebrow" style="color: var(--gold);">{homeContent.footer.hoursTitle}</p>
      <p style="color: var(--cream); font-size: 0.95rem;">
        <svg
          style="width: 1.1rem; height: 1.1rem; fill: var(--gold); display: inline-block; vertical-align: sub; margin-right: 0.35rem;"
          viewBox="0 0 24 24"
        >
          <path
            d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z"
          ></path>
        </svg>
        {siteConfig.hours.serviceDays}
      </p>
      <p style="color: var(--muted-foreground); font-size: 0.9rem;">{siteConfig.hours.seatings}</p>
      <p style="color: var(--muted-foreground); font-size: 0.85rem;">
        Fechado: {siteConfig.hours.closed}
      </p>
    </div>

    <div class="footer-col">
      <p class="label-eyebrow" style="color: var(--gold);">{homeContent.footer.contactTitle}</p>
      <p style="margin-bottom: 0.5rem;">
        <a
          href={siteConfig.whatsappUrl}
          target="_blank"
          rel="noreferrer"
          style="color: var(--gold); font-weight: 600; display: inline-flex; align-items: center; gap: 0.35rem;"
        >
          <svg style="width: 1.1rem; height: 1.1rem; fill: #25d366;" viewBox="0 0 24 24">
            <path
              d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"
            ></path>
          </svg>
          WhatsApp Reservas
        </a>
      </p>
      <p>
        <a href={`mailto:${siteConfig.email}`} style="color: var(--muted-foreground);"
          >{siteConfig.email}</a>
      </p>
      <ul style="margin-top: 1rem;">
        {
          siteConfig.social.map((item) => (
            <li>
              <a href={item.href} target="_blank" rel="noreferrer">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="footer-bottom">
      <p>&copy; {year} {siteConfig.fullName}. Todos os direitos reservados.</p>
      <p><span class="ember-dot" aria-hidden="true"></span> {homeContent.footer.signal}</p>
    </div>
  </div>
</footer>

<!-- Floating WhatsApp Contact Button -->
<a
  class="floating-whatsapp"
  href={siteConfig.whatsappUrl}
  target="_blank"
  rel="noreferrer"
  aria-label="Reservar mesa via WhatsApp"
>
  <svg class="floating-whatsapp-icon" viewBox="0 0 24 24">
    <path
      d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"
    ></path>
  </svg>
  <span>Reservar Mesa</span>
</a>
