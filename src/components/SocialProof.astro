---
import { homeContent } from "../config/home";
---

<section id="avaliacoes" class="section surface-section">
  <div class="container section-grid">
    <div class="section-kicker">
      <p class="label-eyebrow reveal" style="color: var(--gold);">{homeContent.reviews.eyebrow}</p>
    </div>

    <div style="grid-column: 4 / span 9;">
      <h2 class="section-heading display reveal">
        {homeContent.reviews.heading}
      </h2>
      <p class="reveal reveal-delay-1" style="font-size: 1.15rem; color: var(--muted-foreground); margin-top: 0.75rem;">
        {homeContent.reviews.subheading}
      </p>

      <div class="reviews-grid reveal reveal-delay-2" style="margin-top: 3rem;">
        {homeContent.reviews.cards.map((card) => (
          <div class="review-card">
            <div>
              <div class="review-rating">{card.rating}</div>
              <blockquote class="review-quote">
                "{card.quote}"
              </blockquote>
            </div>
            <div class="review-author">
              <span style="color: var(--cream); font-weight: 600;">{card.author}</span>
              <span class="review-source">{card.source}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
