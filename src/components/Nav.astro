---
import { siteConfig } from "../config/site";
---

<header class="site-header">
  <div class="nav-grid">
    <a class="brand" href="#top" aria-label={`${siteConfig.name} - Página inicial`}>
      <!-- Logo para o menu parado (fundo amarelo) -->
      <img
        src="/logo.jpg"
        alt="Logo Pot. Pourri"
        class="brand-logo brand-logo--default"
        width="160"
        height="160"
      />
      <!-- Logo para o menu ao rolar (scroll) -->
      <img
        src="/xlogo.png"
        alt="Logo Pot. Pourri Scroll"
        class="brand-logo brand-logo--scrolled"
        width="160"
        height="160"
      />
      <span class="brand-title">{siteConfig.name.toUpperCase()}</span>
    </a>
    <nav class="nav-links" aria-label="Navegação principal">
      {siteConfig.nav.map((item) => <a href={item.href}>{item.label}</a>)}
      <a class="nav-cta" href={siteConfig.whatsappUrl} target="_blank" rel="noreferrer">
        <span class="ember-dot" aria-hidden="true"></span>
        Reservar Mesa
      </a>
    </nav>
    <details class="mobile-nav">
      <summary class="mobile-nav__toggle">Menu</summary>
      <nav class="mobile-nav__panel" aria-label="Navegação mobile">
        {siteConfig.nav.map((item) => <a href={item.href}>{item.label}</a>)}
        <a class="nav-cta" href={siteConfig.whatsappUrl} target="_blank" rel="noreferrer">
          <span class="ember-dot" aria-hidden="true"></span>
          Reservar Mesa via WhatsApp
        </a>
      </nav>
    </details>
  </div>
</header>
