---
import { Image } from "astro:assets";
import { homeContent } from "../config/home";
import pizzaImage from "../assets/pizza.jpg";
---

<section id="conceito" class="section concept-section">
  <div class="container section-grid">
    <div class="section-kicker">
      <p class="label-eyebrow reveal" style="color: var(--gold);">{homeContent.concept.eyebrow}</p>
    </div>

    <h2 class="section-heading display reveal">
      {homeContent.concept.heading}
    </h2>

    <div class="text-block reveal reveal-delay-1">
      {homeContent.concept.body.map((paragraph) => (
        <p style="margin-bottom: 1.25rem; font-size: 1.1rem; line-height: 1.75; color: var(--foreground);">{paragraph}</p>
      ))}

      <div class="concept-highlight-grid" style="margin-top: 2rem;">
        {homeContent.concept.highlights.map((item) => (
          <div class="concept-highlight-card">
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </div>
        ))}
      </div>
    </div>

    <figure class="figure-detail reveal">
      <div class="image-frame aspect-4-5" style="border: 1px solid var(--border); border-radius: 2px;">
        <Image
          src={pizzaImage}
          alt={homeContent.concept.imageAlt}
          width={1200}
          height={1500}
          loading="lazy"
        />
      </div>
    </figure>
  </div>
</section>
